<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenCode Launcher"
        Width="1360" Height="900" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <Image x:Name="LogoImage" Width="21" Height="21" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Text="OpenCode" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Launcher" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               Margin="5,1,0,0" VerticalAlignment="Center"/>

                    <Border x:Name="StatusPill" CornerRadius="10" Background="#16281F"
                            Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#45D09E" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="检测中" Foreground="#7BE3B4"
                                       FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="UrlText" Text="—" Foreground="#7E8899" FontSize="11.5"
                               FontFamily="Cascadia Mono, Consolas" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               MaxWidth="300" Cursor="Hand" ToolTip="点击地址复制；Ctrl+点击在浏览器打开。"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStart" Content="启动" Style="{StaticResource ToolButton}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnRestart" Content="重启" Style="{StaticResource ToolButton}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnStop" Content="停止" Style="{StaticResource ToolButton}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnWebToggle" Content="隐藏页面" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            ToolTip="隐藏内嵌 Web 页面，降低 CPU/内存占用"/>
                    <Border Width="1" Height="18" Background="#2A3340" Margin="4,0,10,0"/>
                    <Button x:Name="BtnBrowser" Content="在浏览器打开" Style="{StaticResource ToolButton}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnAccess" Content="访问地址" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            ToolTip="查看 Web 界面访问地址"/>
                    <Button x:Name="BtnSettings" Content="设置" Style="{StaticResource ToolButton}" Margin="0,0,6,0"/>
                    <Button x:Name="BtnTray" Content="最小化" Style="{StaticResource GhostButton}" ToolTip="隐藏到系统托盘"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内嵌 Web 界面 -->
        <Grid Grid.Row="1">
            <Border x:Name="WebHost" Background="#0B0D11"/>

            <Grid x:Name="Overlay" Background="{StaticResource BgBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24">
                    <Grid x:Name="SpinnerBox" Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,18">
                        <Path Data="M 13,2 A 11,11 0 1 1 12.99,2" Stroke="{StaticResource AccentBrush}"
                              StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="OverlayTitle" Text="正在启动" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OverlayMessage" Text="正在连接 OpenCode 后台服务…"
                               FontSize="12.5" Foreground="{StaticResource MutedBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,10,0,0" LineHeight="20"/>
                    <StackPanel x:Name="OverlayAddressModeRow" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,12,0,0" Visibility="Collapsed">
                        <ToggleButton x:Name="OverlayCodeMode" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      ToolTip="开启后地址显示为带 code 的一次性链接，5 分钟内有效"
                                      AutomationProperties.Name="使用一次性登录链接"/>
                        <TextBlock x:Name="OverlayCodeLabel" Text="使用一次性链接" Foreground="{StaticResource TextBrush}" FontSize="11.5"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="OverlayPairStatus" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="OverlayRefreshPair" Content="刷新" Style="{StaticResource StatusLink}"
                                Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="重新生成一次性链接"/>
                    </StackPanel>
                    <ScrollViewer x:Name="OverlayAddressScroll" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="OverlayAddressList"/>
                    </ScrollViewer>
                    <TextBlock x:Name="OverlayAddressHint" Text="点击地址复制；Ctrl+点击在浏览器打开。" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <StackPanel x:Name="OverlayActions" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,22,0,0">
                        <Button x:Name="BtnOverlayShow" Content="显示页面" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,10,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnOverlayStart" Content="启动服务" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,10,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnOverlayLogin" Content="打开登录页" Style="{StaticResource ToolButton}"
                                Margin="0,0,10,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnOverlayRetry" Content="重试" Style="{StaticResource ToolButton}"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 日志抽屉 -->
        <Border x:Name="LogPanel" Grid.Row="2" Height="0" Background="#10141A"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="14,0">
                    <TextBlock Text="运行日志" Foreground="{StaticResource MutedBrush}" FontSize="11.5"
                               VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnCopyLog" Content="复制" Style="{StaticResource StatusLink}"/>
                        <Button x:Name="BtnClearLog" Content="清空" Style="{StaticResource StatusLink}"/>
                        <Button x:Name="BtnCloseLog" Content="收起" Style="{StaticResource StatusLink}"/>
                    </StackPanel>
                </Grid>
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" BorderThickness="0"
                         Background="#10141A" Foreground="#93A1B5" Padding="14,4,14,8"
                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </Grid>
        </Border>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock x:Name="ExeText" Text="opencode" Foreground="#6F7A8B" FontSize="11.5"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="640"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ActionText" Text="就绪" Foreground="#8B95A6" FontSize="11.5"
                               Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnLog" Content="日志" Style="{StaticResource StatusLink}"/>
                    <Button x:Name="BtnOpenData" Content="配置目录" Style="{StaticResource StatusLink}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 访问地址气泡 -->
        <Popup x:Name="AccessPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom"
               VerticalOffset="8" HorizontalOffset="-320">
            <Border x:Name="AccessCard" Width="460" Background="#151A22" BorderBrush="#2A3340"
                    BorderThickness="1" CornerRadius="12" Padding="16" Focusable="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Web 访问地址" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="AccessClose" Content="✕" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Padding="6,2" FontSize="12" ToolTip="关闭"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ToggleButton x:Name="AccessCodeMode" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                      ToolTip="开启后地址显示为带 code 的一次性链接，5 分钟内有效"
                                      AutomationProperties.Name="使用一次性登录链接"/>
                        <TextBlock x:Name="AccessCodeLabel" Text="使用一次性链接" Foreground="{StaticResource TextBrush}"
                                   FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="AccessPairStatus" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Button x:Name="AccessRefreshPair" Content="刷新" Style="{StaticResource StatusLink}"
                                Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" ToolTip="重新生成一次性链接"/>
                    </StackPanel>
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                        <StackPanel x:Name="AccessUrlList"/>
                    </ScrollViewer>
                    <TextBlock x:Name="AccessHint" Text="点击地址复制；Ctrl+点击在浏览器打开。" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="17"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
