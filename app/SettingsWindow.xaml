<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="620" Height="740" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock Text="设置" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="服务参数会写入 opencode 的 service.json，保存后生效。"
                           FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,4,24,20">

                <TextBlock Text="服务参数" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="监听地址" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="S_Host"/>
                <TextBlock Text="留空表示 127.0.0.1（仅本机）。填 0.0.0.0 可让局域网内的设备访问。"
                           Style="{StaticResource FieldHint}"/>

                <TextBlock Text="端口" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="S_Port"/>
                <TextBlock Text="留空使用 opencode 分配的默认端口。修改端口后需要重启服务。"
                           Style="{StaticResource FieldHint}"/>

                <TextBlock Text="访问密码" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="S_Password" VerticalAlignment="Center"/>
                    <TextBox x:Name="S_PasswordPlain" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <Button x:Name="S_TogglePassword" Grid.Column="1" Content="显示" Style="{StaticResource ToolButton}"
                            Margin="10,0,0,0" Padding="12,8" ToolTip="显示或隐藏密码明文"/>
                </Grid>
                <TextBlock Text="留空则取消密码保护（不推荐）。修改密码后，已连接的浏览器需要重新配对。"
                           Style="{StaticResource FieldHint}"/>
                <TextBlock x:Name="S_PasswordSource" FontSize="11" Foreground="#6F7A8B"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="CORS 来源" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="S_Cors"/>
                <TextBlock Text="多个来源用英文逗号分隔，例如 https://app.example.com,https://other.example.com。留空表示不额外允许。"
                           Style="{StaticResource FieldHint}"/>

                <TextBlock Text="程序" Style="{StaticResource SectionTitle}"/>

                <TextBlock Text="opencode 可执行文件" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="S_Exe" VerticalAlignment="Center"/>
                    <Button x:Name="S_Browse" Grid.Column="1" Content="浏览…" Style="{StaticResource ToolButton}"
                            Margin="10,0,0,0" Padding="14,8"/>
                </Grid>
                <TextBlock Text="支持 opencode.exe、opencode.cmd 或 opencode.ps1。程序会自动探测常见安装位置。"
                           Style="{StaticResource FieldHint}"/>

                <CheckBox x:Name="S_AutoStart" Content="启动 Launcher 时自动启动后台服务" Margin="0,18,0,0"/>
                <CheckBox x:Name="S_CloseTray" Content="关闭窗口时最小化到系统托盘" Margin="0,12,0,0"/>
                <CheckBox x:Name="S_SuspendHide" Content="最小化到托盘时挂起内嵌页面（降低 CPU/内存占用）" Margin="0,12,0,0"/>
                <CheckBox x:Name="S_StopExit" Content="退出 Launcher 时停止后台服务" Margin="0,12,0,0"/>
                <Button x:Name="S_DesktopShortcut" Content="创建桌面快捷方式" Style="{StaticResource ToolButton}"
                        HorizontalAlignment="Left" Margin="0,18,0,0" Padding="14,8"/>
                <TextBlock Text="在桌面创建指向本启动器的快捷方式。" Style="{StaticResource FieldHint}"/>

                <TextBlock Text="配置文件" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="S_ConfigPath" FontSize="11" Foreground="#6F7A8B"
                           TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>

                <TextBlock x:Name="S_Error" Foreground="#F07178" FontSize="12" TextWrapping="Wrap"
                           Margin="0,18,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <TextBlock Text="保存后会自动重启正在运行的服务" FontSize="11.5" Foreground="#6F7A8B"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="S_Cancel" Content="取消" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Padding="18,8"/>
                    <Button x:Name="S_Save" Content="保存" Style="{StaticResource ToolButton}" Margin="0,0,8,0" Padding="18,8"/>
                    <Button x:Name="S_SaveRestart" Content="保存并重启" Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
